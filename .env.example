# ==============================================================================
# TANVELO ENVIRONMENT CONFIGURATION (.env.example)
# Universal AI Memory Layer — Phase 1 Hackathon MVP
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
TANVELO_ENV=development
# Generate a secret key in production (e.g., openssl rand -hex 32)
SECRET_KEY=tv_sec_change_me_in_production_f729b8c3098e

# ------------------------------------------------------------------------------
# 2. PERSISTENT DATABASE (Supabase PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# Default for quick local testing (SQLite with vector serialization):
DATABASE_URL=sqlite+aiosqlite:///./tanvelo.db

# For Production with Supabase:
# 1. Create a project at https://supabase.com
# 2. Enable 'vector' extension under Database -> Extensions
# 3. Run migrations/001_initial_schema.sql in the SQL Editor
# 4. Paste your asyncpg connection string below:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. AI DECISION MODEL (NVIDIA Nemotron Nano 8B)
# ------------------------------------------------------------------------------
# Get your free NVIDIA NIM API key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ------------------------------------------------------------------------------
# 4. EMBEDDING SERVICE (NVIDIA / OpenAI / Mock)
# ------------------------------------------------------------------------------
# Option A: NVIDIA Embeddings (Default)
EMBEDDING_PROVIDER=nvidia
EMBEDDING_API_KEY=nvapi-your-nvidia-api-key-here
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSION=1536

# Option B: OpenAI Embeddings (Alternative)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-proj-your-openai-api-key-here
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# 5. MCP CLIENT AUTHENTICATION
# ------------------------------------------------------------------------------
# Auto-generated when running 'python scripts/setup_db.py'
# Configure this key in Cursor (~/.cursor/mcp.json) or Claude Code settings
TANVELO_API_KEY=tv_live_your_tanvelo_api_key_here

# ------------------------------------------------------------------------------
# 6. MEMORY DECISION & HYBRID RANKING WEIGHTS
# ------------------------------------------------------------------------------
# Final Score = (0.60 * Sim) + (0.25 * Imp) + (0.15 * Rec)
DUPLICATE_SIMILARITY_THRESHOLD=0.90
RANKING_WEIGHT_SIMILARITY=0.60
RANKING_WEIGHT_IMPORTANCE=0.25
RANKING_WEIGHT_RECENCY=0.15
DEFAULT_TOP_K=5

# ------------------------------------------------------------------------------
# 7. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
