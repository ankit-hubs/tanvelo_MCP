# ==============================================================================
# TANVELO CONFIGURATION ENVIRONMENT TEMPLATE (.env)
# Universal Long-Term AI Memory Layer — Production Ready
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & SECURITY
# ------------------------------------------------------------------------------
TANVELO_ENV=production
# Generate a cryptographically secure key: openssl rand -hex 32
SECRET_KEY=tv_sec_production_secret_key_change_me_immediately
CORS_ORIGINS=["*"]
MAX_REQUEST_BODY_BYTES=2097152

# ------------------------------------------------------------------------------
# 2. PERSISTENT DATABASE (PostgreSQL + pgvector / Supabase / Neon / RDS)
# ------------------------------------------------------------------------------
# Production PostgreSQL + pgvector connection string:
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/tanvelo

# For Local Testing / Embedded:
# DATABASE_URL=sqlite+aiosqlite:///./tanvelo.db

# Database Connection Pool Settings:
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ------------------------------------------------------------------------------
# 3. AI DECISION ENGINE & LLM PROVIDER
# ------------------------------------------------------------------------------
# Provider Options: "nvidia", "openai", "anthropic", "ollama", "mock"
LLM_PROVIDER=nvidia

# Option A: NVIDIA NIM (Nemotron Nano 8B / Llama 3.1)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Option B: OpenAI
# OPENAI_API_KEY=sk-proj-your-openai-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option C: Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Option D: Ollama (Local Self-Hosted)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=nemotron-mini

# ------------------------------------------------------------------------------
# 4. EMBEDDING SERVICE (NVIDIA / OpenAI / Ollama / Local)
# ------------------------------------------------------------------------------
# Option A: NVIDIA NIM Embeddings (Default)
EMBEDDING_PROVIDER=nvidia
EMBEDDING_API_KEY=nvapi-your-nvidia-api-key-here
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSION=1536
EMBEDDING_CACHE_SIZE=5000

# Option B: OpenAI Embeddings
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-proj-your-openai-key
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# 5. MCP CLIENT AUTHENTICATION
# ------------------------------------------------------------------------------
# Used by MCP clients (Cursor, Claude Code, Windsurf, Codex CLI)
TANVELO_API_KEY=tv_live_your_tanvelo_api_key_here

# ------------------------------------------------------------------------------
# 6. MEMORY DECISION & HYBRID RANKING WEIGHTS
# ------------------------------------------------------------------------------
# Final Score = (0.60 * Sim) + (0.25 * Imp) + (0.15 * Rec)
DUPLICATE_SIMILARITY_THRESHOLD=0.85
RANKING_WEIGHT_SIMILARITY=0.60
RANKING_WEIGHT_IMPORTANCE=0.25
RANKING_WEIGHT_RECENCY=0.15
DEFAULT_TOP_K=5
RECENCY_HALF_LIFE_DAYS=30.0

# ------------------------------------------------------------------------------
# 7. RATE LIMITING & NETWORK SAFETY
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
HTTP_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 8. SERVER HOST & PORTS
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
MCP_PORT=8001
LOG_LEVEL=INFO
